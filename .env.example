# Public runtime configuration. Safe to expose to the browser.

# Canonical origin used for canonical tags, Open Graph URLs, robots and sitemap.
NUXT_PUBLIC_SITE_URL=https://streampayjm.com

# Where "Sign in" and "Open the dashboard" point.
# Production default: https://app.streampayjm.com
NUXT_PUBLIC_DASHBOARD_URL=http://localhost:4200

# Stealth switch. Leave false while the site is pre-launch: robots.txt
# disallows everything, pages send noindex, and the sitemap stays empty.
# Set to true at launch to open the site to search engines.
NUXT_PUBLIC_INDEXABLE=false
